{
  "name": "ad-sentinel",
  "version": "0.5.0",
  "private": true,
  "description": "AD Sentinel — 広告の文面を jev で判定し、悪質な広告だけをぼかす Chrome 拡張",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "node scripts/build.mjs && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
